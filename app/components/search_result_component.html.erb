<div class="result">
<%# This template copies from Blacklight's components/document_component.html.erb
      # for the wrapping `content_tag @component` structure
      # and adds custom layout within for the document header, badges and more-info areas %>

  <%= content_tag @component,
    id: @id,
    data: {
      'document-id': @document.id.to_s.parameterize,
      'map-id': @document.id.to_s,
      'document-counter': @counter
    },
    itemscope: true,
    itemtype: @document.itemtype,
    class: classes.flatten.join(' ') do %>
    <%= content_tag :div, class: 'row index-split d-flex flex-grow-1 flex-column' do %>
      <%= title %>
      <div class="flex-grow-1 ms-0">
        <%= render Geoblacklight::HeaderBadgesComponent.new(document: @document) %>
      </div>
    <% end %>
  <% end %>
  <div class="more-info-area border-bottom px-2">
    <div id="doc-<%= @document.id %>-fields-collapse" class="collapse description pb-2" data-controller="description">
      <small itemprop="description">
        <%= description %>
      </small>
    </div>
  </div>
</div>
