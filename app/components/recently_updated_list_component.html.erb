<section class="recently-updated <%= type %> d-flex gap-2" aria-labelledby="<%= heading_id%>">
  <%= helpers.geoblacklight_icon(type) %>

  <div class="content">
    <%= tag.h2 t("earthworks.home.#{type}.header"), class: "h1" , id: heading_id %>
    <%= tag.p t("earthworks.home.#{type}.description_html", sets: number_with_delimiter(total)) %>

    <%= tag.h3 t("earthworks.home.recently_updated"), class: "h2" %>
    <ul class="list-unstyled">
      <% documents.each do |document| %>
        <%= tag.li link_to(document.title, solr_document_path(document)) %>
      <% end %>
    </ul>
    <div class="d-flex justify-content-end">
      <%= link_to t("earthworks.home.#{type}.button_text"), search_url, class: 'btn btn-outline-primary' %>
    </div>
  </div>
</section>
