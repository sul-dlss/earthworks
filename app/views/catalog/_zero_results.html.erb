<%= render 'did_you_mean' %>
<%= tag.h2 t('blacklight.search.zero_results.title') %>
<%= tag.div(id: "documents", class: "noresults") do %>
  <%= tag.h3 t('blacklight.search.zero_results.modify_search'), class: "modify-search" %>
  <%= tag.p t('blacklight.search.zero_results.use_fewer_keywords') %>
  <%= tag.h3 t('earthworks.search.zero_results.ask_for_dataset'), class: "ask-for-dataset" %>
  <%= tag.p t('earthworks.search.zero_results.use_feedback_html',
    link: link_to(
      t('earthworks.search.zero_results.submit_feedback'),
      '#feedback',
      data: { bs_toggle: 'collapse', bs_target: '#feedback'}
    ))
  %>
<% end %>
