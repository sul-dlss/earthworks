<div class="row my-4">
  <div class="col-sm">
  <%= render blacklight_config.index.search_bar_component.new(
      url: search_action_url,
      advanced_search_url: search_action_url(action: 'advanced_search'),
      params: search_state.params_for_search.except(:qt),
      autocomplete_path: suggest_index_catalog_path
    ) %>
  <%= tag.h1 t("earthworks.home.title"), class: "visually-hidden" %>
  <% @recently_updated.each do |term, response| %>
    <hr>
    <%= render RecentlyUpdatedListComponent.new(response:, term:) %>
  <% end %>
  </div>
  <div class="col-sm d-none d-md-block">
    <%= render(Geoblacklight::OverviewMapComponent.new(geosearch: true)) %>
  </div>
</div>
