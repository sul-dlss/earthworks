<div id="sortAndPerPage" class="sort-pagination d-lg-flex justify-content-between" role="navigation" aria-label="<%= t('blacklight.search.per_page.aria_label') %>">
  <%= render partial: "paginate_compact", object: @response if show_pagination? %>
  <div class="search-widgets justify-content-center">
    <%= render_results_collection_tools %>
    <%# A Bootstrap radio button group: the radios are clipped rather than hidden, so they
          stay focusable, and each button takes its pressed state from its own radio. %>
    <div class="toggle-descriptions btn-group" role="group" aria-label="search result descriptions"
      data-controller="toggledescriptions" data-toggledescriptions-description-outlet=".description-container">
      <input type="radio" class="btn-check" name="toggledescriptions" id="hide-all-descriptions" autocomplete="off"
        aria-label="hide all descriptions" data-action="change->toggledescriptions#hideDescriptions" checked>
      <label class="btn btn-outline-primary" for="hide-all-descriptions">
        <i class="bi bi-list-ul" aria-hidden="true"></i>
      </label>
      <input type="radio" class="btn-check" name="toggledescriptions" id="show-all-descriptions" autocomplete="off"
        aria-label="show all descriptions" data-action="change->toggledescriptions#showDescriptions">
      <label class="btn btn-outline-primary" for="show-all-descriptions">
        <i class="bi bi-text-paragraph" aria-hidden="true"></i>
      </label>
    </div>
  </div>
</div>
